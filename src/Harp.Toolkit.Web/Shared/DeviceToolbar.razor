@using System.Runtime.Versioning
@attribute [SupportedOSPlatform("browser")]
@implements IDisposable
@inject DeviceSession Session

<div class="toolbar">
    <span class="state-dot state-@Session.State.ToString().ToLowerInvariant()" aria-hidden="true"></span>
    <span class="device-label" title="@Session.PortLabel">
        @if (Session.Identity is { } identity && Session.State == SessionState.Connected)
        {
            <strong>@identity.DisplayName</strong>
            <span class="detail hide-narrow">· @Session.PortLabel</span>
        }
        else
        {
            <span>@StateText</span>
        }
    </span>
    <span class="spacer"></span>
    <button class="btn" disabled="@(Session.State is SessionState.Connecting or SessionState.Busy)" @onclick="Session.SelectPortAsync">
        @Icons.Plug <span class="hide-narrow">Select port</span>
    </button>
    @if (Session.State == SessionState.Connected)
    {
        <button class="btn" @onclick="Session.DisconnectAsync">Disconnect</button>
    }
    else
    {
        <button class="btn btn-primary" disabled="@(Session.State != SessionState.Disconnected)" @onclick="Session.ConnectAsync">Connect</button>
    }
</div>
@if (Session.Error is { } error)
{
    <div class="status">
        <div class="status-line status-error" role="alert">@Icons.Error <span>@error</span></div>
    </div>
}

@code {
    string StateText => Session.State switch
    {
        SessionState.NoPort => "No device selected",
        SessionState.Disconnected => $"Disconnected · {Session.PortLabel}",
        SessionState.Connecting => "Connecting…",
        SessionState.Busy => "Busy…",
        _ => Session.PortLabel
    };

    protected override void OnInitialized() => Session.Changed += OnChanged;

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;
}
