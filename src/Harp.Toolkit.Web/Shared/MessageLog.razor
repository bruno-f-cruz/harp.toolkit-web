@using System.Diagnostics
@using System.Globalization
@using System.Runtime.Versioning
@using Bonsai.Harp
@attribute [SupportedOSPlatform("browser")]
@implements IDisposable
@inject DeviceSession Session

<div class="toolbar">
    <span class="pane-title">Messages</span>
    <div class="segmented" role="radiogroup" aria-label="Messages to show">
        @foreach (var option in Filters)
        {
            <button role="radio" aria-checked="@(filter == option ? "true" : "false")" @onclick="() => SetFilter(option)">@option</button>
        }
    </div>
    @if (SelectedName is not null)
    {
        <label class="field check" title="Show only messages from @SelectedName">
            <input type="checkbox" checked="@onlySelected" @onchange="ToggleOnlySelected" />
            <span>Only @SelectedName</span>
        </label>
    }
    <span class="spacer"></span>
    <span class="file-meta">@rate.ToString("0", CultureInfo.InvariantCulture)/s</span>
    <button class="btn" @onclick="TogglePause" title="@(paused ? "Show new messages again" : "Stop adding new messages")">@(paused ? "Resume" : "Pause")</button>
    <button class="btn" @onclick="Clear">Clear</button>
    @if (OnToggleCollapsed.HasDelegate)
    {
        <button class="btn" @onclick="OnToggleCollapsed" aria-expanded="@(Collapsed ? "false" : "true")"
                title="@(Collapsed ? "Show the message log" : "Hide the message log")">@(Collapsed ? "Show" : "Hide")</button>
    }
</div>
@if (inspected is { } frame && !Collapsed)
{
    <div class="log-inspector">
        <div class="log-inspector-header">
            <span class="label">Frame</span>
            <span class="detail">@frame.Type · @frame.Register@(frame.Time.Length > 0 ? $" · {frame.Time} s" : null)</span>
            <span class="spacer"></span>
            @if (OnSelect.HasDelegate)
            {
                <button class="link-button" @onclick="() => OnSelect.InvokeAsync(frame.Address)">Open @frame.Register</button>
            }
            <button class="btn btn-icon btn-ghost" title="Close the frame" aria-label="Close the frame" @onclick="() => inspected = null">✕</button>
        </div>
        <FrameView Message="frame.Message" Register="Session.Schema.Registers.GetValueOrDefault(frame.Address)" />
    </div>
}
<div class="log" role="log" aria-live="off" hidden="@Collapsed">
    @if (visible.Count == 0)
    {
        <div class="empty">
            <p>
                @(Session.IsConnected
                    ? "Replies and events from the device appear here. Switch the device to Active to stream events."
                    : "Connect a device to see its messages.")
            </p>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Time (s)</th><th>Type</th><th>Register</th><th>Value</th><th class="hide-narrow">Bytes</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in visible)
                {
                    var selected = entry.Id == inspected?.Id;
                    <tr class="clickable @(entry.Error ? "row-error" : null) @(selected ? "selected" : null)"
                        title="Show the frame" aria-selected="@(selected ? "true" : "false")"
                        @onclick="() => inspected = entry">
                        <td class="num">@entry.Time</td>
                        <td><span class="type type-@entry.Type.ToLowerInvariant()">@entry.Type</span></td>
                        <td title="Address @entry.Address">@entry.Register</td>
                        <td class="payload">@entry.Payload</td>
                        <td class="bytes hide-narrow">@entry.Bytes</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    const int MaxEntries = 500;
    const int RefreshMilliseconds = 200;
    static readonly string[] Filters = ["All", "Events", "Replies"];

    readonly LinkedList<LogEntry> entries = new();
    readonly List<LogEntry> visible = [];
    readonly Stopwatch rateClock = Stopwatch.StartNew();
    Timer? refresh;
    string filter = "All";
    bool paused;
    bool dirty;
    long countSinceRate;
    double rate;

    bool onlySelected;
    long nextId;
    LogEntry? inspected;

    [Parameter] public EventCallback<int> OnSelect { get; set; }

    /// <summary>The address of the register selected on the page, which the log can filter to.</summary>
    [Parameter] public int? SelectedAddress { get; set; }

    /// <summary>The name of the selected register, or <see langword="null"/> to hide the filter.</summary>
    [Parameter] public string? SelectedName { get; set; }

    [Parameter] public bool Collapsed { get; set; }

    [Parameter] public EventCallback OnToggleCollapsed { get; set; }

    record LogEntry(long Id, HarpMessage Message, string Time, string Type, int Address, string Register, string Payload, string Bytes, bool Error, bool IsEvent);

    int? shownAddress;

    protected override void OnParametersSet()
    {
        // Follow the selection while filtering to it.
        if (shownAddress != SelectedAddress)
        {
            shownAddress = SelectedAddress;
            dirty = true;
            Refresh();
        }
    }

    void ToggleOnlySelected()
    {
        onlySelected = !onlySelected;
        dirty = true;
        Refresh();
    }

    protected override void OnInitialized()
    {
        Session.MessageReceived += OnMessage;
        Session.Changed += OnChanged;
        refresh = new Timer(_ => InvokeAsync(Refresh), null, RefreshMilliseconds, RefreshMilliseconds);
    }

    void OnMessage(HarpMessage message)
    {
        countSinceRate++;
        if (paused)
            return;

        entries.AddFirst(ToEntry(message));
        if (entries.Count > MaxEntries)
            entries.RemoveLast();
        dirty = true;
    }

    LogEntry ToEntry(HarpMessage message)
    {
        var time = message.TryGetTimestamp(out var timestamp) ? timestamp.ToString("0.000000", CultureInfo.InvariantCulture) : "";
        var register = Session.Schema.Registers.GetValueOrDefault(message.Address);
        string payload;
        if (message.Error)
            payload = "rejected";
        else
        {
            try
            {
                payload = register is not null ? PayloadCodec.Summarize(register, message) : PayloadFormat.Format(message);
            }
            catch (FormatException)
            {
                payload = Convert.ToHexString(message.GetPayload());
            }
        }

        return new LogEntry(
            nextId++,
            message,
            time,
            message.MessageType.ToString(),
            message.Address,
            register?.Name ?? message.Address.ToString(CultureInfo.InvariantCulture),
            payload,
            Convert.ToHexString(message.GetPayload()),
            message.Error,
            message.MessageType == MessageType.Event);
    }

    void Refresh()
    {
        var elapsed = rateClock.Elapsed.TotalSeconds;
        if (elapsed >= 1)
        {
            rate = countSinceRate / elapsed;
            countSinceRate = 0;
            rateClock.Restart();
            dirty = true;
        }

        if (!dirty)
            return;

        dirty = false;
        visible.Clear();
        visible.AddRange(entries.Where(entry =>
            (!onlySelected || SelectedName is null || entry.Address == SelectedAddress) &&
            filter switch
            {
                "Events" => entry.IsEvent,
                "Replies" => !entry.IsEvent,
                _ => true
            }));
        StateHasChanged();
    }

    void SetFilter(string option)
    {
        filter = option;
        dirty = true;
        Refresh();
    }

    void TogglePause() => paused = !paused;

    void Clear()
    {
        entries.Clear();
        dirty = true;
        Refresh();
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.MessageReceived -= OnMessage;
        Session.Changed -= OnChanged;
        refresh?.Dispose();
    }
}
