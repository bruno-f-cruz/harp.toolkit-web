@page "/device"
@using System.Runtime.Versioning
@using Bonsai.Harp
@attribute [SupportedOSPlatform("browser")]
@implements IDisposable
@inject DeviceSession Session

<PageTitle>Device · Harp.Toolkit</PageTitle>

@if (!Session.IsSupported)
{
    <main class="workspace">
        <UnsupportedBrowser />
    </main>
}
else
{
    <div class="device-page">
        <DeviceBar>
            @if (Session.IsConnected)
            {
                <div class="segmented" role="radiogroup" aria-label="Operation mode"
                     title="Devices only send events in Active mode">
                    <button role="radio" aria-checked="@Checked(Session.OperationMode == OperationMode.Standby)" disabled="@busy"
                            @onclick="() => SetModeAsync(OperationMode.Standby)">Standby</button>
                    <button role="radio" aria-checked="@Checked(Session.OperationMode == OperationMode.Active)" disabled="@busy"
                            @onclick="() => SetModeAsync(OperationMode.Active)">Active</button>
                </div>
                <button class="btn hide-narrow" disabled="@busy" title="Ask the device to send the value of every register"
                        @onclick="DumpRegistersAsync">Read all</button>
            }
        </DeviceBar>
        @if (modeError is not null)
        {
            <div class="status-line status-error" role="alert">@Icons.Error <span>@modeError</span></div>
        }

        <main class="workspace device-workspace">
            <section class="pane" aria-label="Registers">
                <RegisterList Selected="selected" OnSelect="Select" />
            </section>

            <section class="pane" aria-label="Selected register">
                <div class="panel-body">
                    @if (Session.Port is null)
                    {
                        <div class="notice">
                            <span>Plug a Harp device in over USB and select its port to read and write its registers.</span>
                            <button class="btn btn-primary" @onclick="Session.SelectPortAsync">@Icons.Plug Select port</button>
                        </div>
                    }
                    @if (SelectedRegister is { } register)
                    {
                        <RegisterEditor Register="register" />
                    }
                    else
                    {
                        <div class="empty">
                            <h2>Pick a register</h2>
                            <p>Choose a register on the left to read it, and to write it with controls built from the device metadata.</p>
                        </div>
                    }
                </div>
            </section>

            <section class="pane" aria-label="Messages">
                <MessageLog OnSelect="Select" />
            </section>
        </main>
    </div>
}

@code {
    int? selected;
    bool busy;
    string? modeError;

    RegisterSchema? SelectedRegister =>
        selected is { } address ? Session.Schema.Registers.GetValueOrDefault(address) : null;

    static string Checked(bool value) => value ? "true" : "false";

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        SelectDefault();
    }

    void OnChanged() => InvokeAsync(() =>
    {
        if (selected is null || SelectedRegister is null)
            SelectDefault();
        StateHasChanged();
    });

    void SelectDefault()
    {
        // Start on the first register specific to the device, or the operation mode when only core registers are known.
        selected = Session.Schema.Registers.Values.FirstOrDefault(register => !register.IsCore)?.Address
            ?? OperationControl.Address;
    }

    void Select(int address) => selected = address;

    async Task SetModeAsync(OperationMode mode) => await RunAsync(() => Session.SetOperationModeAsync(mode));

    async Task DumpRegistersAsync() =>
        await RunAsync(() => Session.SetOperationModeAsync(Session.OperationMode ?? OperationMode.Standby, dumpRegisters: true));

    async Task RunAsync(Func<Task> action)
    {
        busy = true;
        modeError = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is HarpException or TimeoutException or IOException or InvalidOperationException)
        {
            modeError = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
