<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Harp.WebSerial is not published yet. Build it with `dotnet pack` in ../Harp.WebSerial. -->
    <add key="Harp.WebSerial (local)" value="../Harp.WebSerial/artifacts/package/release" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Harp.WebSerial (local)">
      <package pattern="Harp.WebSerial" />
    </packageSource>
  </packageSourceMapping>
</configuration>
